/*
  EJEMPLO DE REFERENCIA — NO DESPLEGAR SIN ADAPTAR LA AUTENTICACIÓN.

  Arquitectura real:
  - utet-4387a: Estudiante + matriculas (base académica, solo lectura desde este sistema).
  - titulos-ec2fa: envios, configuracion, workflow_events, coordinadores,
    investigadores, periodos, carreras, resoluciones e ia.

  La aplicación pública de estudiantes actualmente no usa un login Firebase
  tradicional. Por eso estas reglas son solo una plantilla de nombres y roles;
  desplegarlas tal cual podría bloquear el flujo público.
*/
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/administradores/$(userEmail()));
    }

    function isCoordinator() {
      return signedIn() &&
        exists(/databases/$(database)/documents/coordinadores/$(userEmail()));
    }

    /*
      Colecciones reales de titulos-ec2fa.
      Definir aquí la política definitiva antes de desplegar.
    */
    match /envios/{titleId} {
      allow read, write: if false;
    }

    match /configuracion/{configId} {
      allow read, write: if false;
    }

    match /workflow_events/{eventId} {
      allow read, write: if false;
    }

    match /versiones_envio/{versionId} {
      allow read, write: if false;
    }

    match /coordinadores/{coordId} {
      allow read, write: if false;
    }

    match /investigadores/{investigadorId} {
      allow read, write: if false;
    }

    match /periodos/{periodId} {
      allow read, write: if false;
    }

    match /carreras/{carreraId} {
      allow read, write: if false;
    }

    match /resoluciones/{resolucionId} {
      allow read, write: if false;
    }

    match /ia/{providerId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
